# Copie para .env e configure no servidor. Nunca envie os segredos ao GitHub.
HOST=127.0.0.1
PORT=3000
COMMERCE_DB_PATH=./data/jaime.sqlite
DELIVERY_FEE_CENTS=500
ADMIN_USER=admin
ADMIN_PASSWORD=
PUBLIC_URL=
MP_MODE=test
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Google Routes: chave exclusiva do servidor
GOOGLE_MAPS_API_KEY=

# Envio automático de PDF de compra via template WhatsApp aprovado.
# Template pt_BR: cabeçalho DOCUMENT e corpo fixo sem parâmetros.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_PURCHASE_TEMPLATE=
